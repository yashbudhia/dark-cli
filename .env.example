# CLI — OpenAI-compatible endpoints
DARK_BASE_URL=            # e.g. Refuseless API base
DARK_API_KEY=
DARK_MODEL=               # planner (abliterated)
DARK_VISION_MODEL=        # operator (vision-capable)

# Native Windows adapter (setup-desktop.ps1 supplies the default path)
DARK_WINDOWS_MCP_PATH=

# Optional Jev next-step preview; no action is executed from the decision
TYPESAFE_API_KEY=
DARK_JEV_BASE_URL=https://api.typesafe.ai
DARK_JEV_MODEL=jev-latest

# Backend
DARK_BACKEND_PORT=8000

# Accounts and CLI pairing (server-side only; never use NEXT_PUBLIC_ for these)
MONGODB_URI=
MONGODB_DATABASE=dark
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
DARK_AUTH_SECRET=
DARK_WEB_URL=http://127.0.0.1:3000

# Email sign-in (Resend recommended; Cloudflare remains supported)
DARK_EMAIL_PROVIDER=resend
RESEND_API_KEY=
DARK_EMAIL_FROM=

# Optional Cloudflare provider, with an onboarded sender domain
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# CLI login points at the website origin; Next proxies /api to the backend
DARK_SERVER_URL=http://127.0.0.1:3000
# Optional installed-client preferences (never contain account tokens)
DARK_CONFIG_DIR=
DARK_ENV_FILE=
# Set in the Next.js environment if the backend is elsewhere
DARK_BACKEND_URL=http://127.0.0.1:8000

# Razorpay checkout (server-side only; never use NEXT_PUBLIC_ for these)
# Dashboard -> Account & Settings -> API keys. Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<your-site>/api/billing/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# Packs ($5, and $10 with $5 free) and the $1 trial are set in backend/app/billing.py.
# Charging USD needs international payments enabled on your Razorpay account.
